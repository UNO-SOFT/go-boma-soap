              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="13"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="building" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Épület</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="10"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="stairway" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Lépcsőház</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="10"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="floor" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Emelet</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="10"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="door" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Ajtó</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="10"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="supplAddress" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Egyéb cím adat. SZL külföldi cím esetén a Lakascim, cégek esetén az Utca mező, szervezetek esetén Cim mező</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="100"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="abstractContractorType" abstract="true">
    <xsd:annotation>
      <xsd:documentation>Szerződő (Természetes személy vagy jogi személy)</xsd:documentation>
    </xsd:annotation>
  </xsd:complexType>
  <xsd:complexType name="simplePersonType">
    <xsd:annotation>
      <xsd:documentation>Természetes személy cím nélkül</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="abstractContractorType">
        <xsd:sequence>
          <xsd:element name="personName" type="personNameType">
            <xsd:annotation>
              <xsd:documentation>Szerződő viselt neve</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="personBirthName" type="personNameType" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Szerződő születési neve</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="placeOfBirth">
            <xsd:annotation>
              <xsd:documentation>Születési hely</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="27"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="dateOfBirth" type="xsd:date">
            <xsd:annotation>
              <xsd:documentation>Születési idő</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="motherMaidenName" type="personNameType">
            <xsd:annotation>
              <xsd:documentation>Szerződő anyja neve</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="citizenship">
            <xsd:annotation>
              <xsd:documentation>Állampolgárság</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:enumeration value="M">
                  <xsd:annotation>
                    <xsd:documentation>Magyar</xsd:documentation>
                  </xsd:annotation>
                </xsd:enumeration>
                <xsd:enumeration value="E">
                  <xsd:annotation>
                    <xsd:documentation>EGT tagállam</xsd:documentation>
                  </xsd:annotation>
                </xsd:enumeration>
                <xsd:enumeration value="K">
                  <xsd:annotation>
                    <xsd:documentation>Egyéb külföldi</xsd:documentation>
                  </xsd:annotation>
                </xsd:enumeration>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="hasResidencePermission" type="xsd:boolean" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Letelepedési / tartózkodási engedéllyel rendelkezik?  Külföldi állampolgárok esetén kötelező.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="personType">
    <xsd:annotation>
      <xsd:documentation>Természetes személy</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="simplePersonType">
        <xsd:sequence>
          <xsd:choice>
            <xsd:annotation>
              <xsd:documentation>Természetes személy címe</xsd:documentation>
            </xsd:annotation>
            <xsd:element name="structuredAddress" type="structuredAddressType">
              <xsd:annotation>
                <xsd:documentation>Ha strukturált cím adat áll rendelkezésre</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="otherAddress" type="otherAddressType">
              <xsd:annotation>
                <xsd:documentation>Nem strukturált cím</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:choice>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="simpleLegalEntityType">
    <xsd:annotation>
      <xsd:documentation>Jogi személy cím nélkül</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="legalEntityName">
        <xsd:annotation>
          <xsd:documentation>A cég, szervezet megnevezése</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="150"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="companyForm">
        <xsd:annotation>
          <xsd:documentation>Cég formája</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:enumeration value="C">
              <xsd:annotation>
                <xsd:documentation>Cég</xsd:documentation>
              </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="R">
              <xsd:annotation>
                <xsd:documentation>Non profit szervezet</xsd:documentation>
              </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="O">
              <xsd:annotation>
                <xsd:documentation>Egyéb</xsd:documentation>
              </xsd:annotation>
            </xsd:enumeration>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="hungaryBased" type="xsd:boolean">
        <xsd:annotation>
          <xsd:documentation>Magyarországi székhelyű?</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:choice>
        <xsd:annotation>
          <xsd:documentation>Nyilvántartási szám </xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
          <xsd:element name="taxNum">
            <xsd:annotation>
              <xsd:documentation>Adószám</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="20"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="registerNum" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Cégjegyzékszám vagy Megyei bírósági azononosító</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="20"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
        <xsd:element name="otherRegisterNum">
          <xsd:annotation>
            <xsd:documentation>Egyéb nyilvántartási szám, csak adószámmal nem rendelkező alanyok esetén használható!</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="50"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
      </xsd:choice>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="legalEntityType">
    <xsd:annotation>
      <xsd:documentation>Jogi személy</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="simpleLegalEntityType">
        <xsd:sequence>
          <xsd:choice>
            <xsd:annotation>
              <xsd:documentation>Jogi személy címe</xsd:documentation>
            </xsd:annotation>
            <xsd:element name="structuredAddress" type="structuredAddressType">
              <xsd:annotation>
                <xsd:documentation>Ha strukturált cím adat áll rendelkezésre</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="otherAddress" type="otherAddressType">
              <xsd:annotation>
                <xsd:documentation>Nem struktúrált cím</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:choice>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="vehicleDataType">
    <xsd:annotation>
      <xsd:documentation>Gépjármű adatai</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="licensePlate" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Rendszám</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="20"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleBodyRegNo">
        <xsd:annotation>
          <xsd:documentation>Alvázszám</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="30"/>
            <xsd:pattern value=".*[A-Za-z0-9].*"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleBrand">
        <xsd:annotation>
          <xsd:documentation>Gyártmány</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="50"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleModel" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Jármű típusa</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="50"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleClass" type="vehicleLegalClassType">
        <xsd:annotation>
          <xsd:documentation>Jármű kategória</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="tempVehicleDataType">
    <xsd:annotation>
      <xsd:documentation>Gépjármű adatai ideiglenes rendszámmal</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="licensePlate">
        <xsd:annotation>
          <xsd:documentation>Rendszám</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="20"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="licensePlateYear" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Ideiglenes rendszám kiadás éve </xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:int">
            <xsd:pattern value="\d{4}"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleBodyRegNo" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Alvázszám</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="30"/>
            <xsd:pattern value=".*[A-Za-z0-9].*"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleBrand" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Gyártmány</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="50"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleModel" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Jármű típusa</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="50"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleClass" type="vehicleLegalClassType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Jármű kategória</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="changeVehicleDataType">
    <xsd:annotation>
      <xsd:documentation>Gépjármű adatai kötvény leíró adatainak megváltoztatásához</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="licensePlate" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Rendszám (Nyilvántartásba vételre nem kötelezett gépjárművek esetén értelem szerűen nem szükséges megadni.) </xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="20"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="licensePlateYear" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Ideiglenes rendszám kiadás éve </xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:int">
            <xsd:pattern value="\d{4}"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleBodyRegNo" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Alvázszám</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="30"/>
            <xsd:pattern value=".*[A-Za-z0-9].*"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleBrand" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Gyártmány</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="50"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleModel" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Jármű típusa</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="50"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleClass" type="vehicleLegalClassType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Jármű kategória</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="licensePlateChange" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Rendszámváltozás</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="changeDate" type="xsd:date">
              <xsd:annotation>
                <xsd:documentation>Rendszám változás dátuma</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="previousLicensePlate">
              <xsd:annotation>
                <xsd:documentation>Előző rendszám</xsd:documentation>
              </xsd:annotation>
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:maxLength value="20"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="damagedVehicleDataType">
    <xsd:annotation>
      <xsd:documentation>Károsult gépjármű adatai</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="licensePlate" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Rendszám (A rendszám vagy alvázszám közül legalább egyik kitöltése kötelező)</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="20"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleBodyRegNo" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Alvázszám (A rendszám vagy alvázszám közül legalább egyik kitöltése kötelező)</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="30"/>
            <xsd:pattern value=".*[A-Za-z0-9].*"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleBrand">
        <xsd:annotation>
          <xsd:documentation>Gyártmány</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="50"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="vehicleModel" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Jármű típusa</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="50"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="policyDataType">
    <xsd:annotation>
      <xsd:documentation>Szerződés adatai típus</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="policyNo" type="policyNoType">
        <xsd:annotation>
          <xsd:documentation>Kötvény száma</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="insuranceStartDate" type="xsd:date">
        <xsd:annotation>
          <xsd:documentation>Biztosítási időszak kezdete</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="insuranceTermDate" type="xsd:date">
        <xsd:annotation>
          <xsd:documentation>Biztosítási időszak vége </xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="extendedPolicyDataType">
    <xsd:annotation>
      <xsd:documentation>Bővített szerződés adatai típus</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="policyDataType">
        <xsd:sequence>
          <xsd:element name="contractingDate" type="bomaDateTime">
            <xsd:annotation>
              <xsd:documentation>Szerződés kötés dátuma + ideje (óra,perc)</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="foreignInsurerName" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Külföldi biztosító megnevezése</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="100"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="riskAssessmentStartDate" type="bomaDateTime">
            <xsd:annotation>
              <xsd:documentation>Kockázatkezelés kezdő dátuma + ideje (óra, perc)</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="riskSharingTermDate" type="bomaDateTime" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Kockázatviselés megszűnésének dátuma + ideje (óra, perc)</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="riskSharingTermCause" type="riskSharingTermCauseType" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Kockázatviselés megszűnésének oka </xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="termComment" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Megjegyzés megszüntetéshez </xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:maxLength value="200"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
          <xsd:element name="unsecuredPeriodStart" type="xsd:date" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Kockázatviselés kezdetét megelőző fedezetlen időszak kezdete</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="unsecuredPeriodEnd" type="xsd:date" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Kockázatviselés kezdetét megelőző fedezetlen időszak vége</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="latePolicyDataType">
    <xsd:annotation>
      <xsd:documentation>Bővített szerződés adatai típus az utólagos bejelentéshez</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="policyDataType">
        <xsd:sequence>
          <xsd:element name="bmRatingBasis" type="bmRatingBasisType">
            <xsd:annotation>
              <xsd:documentation>Besorolás alapja</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="bmRating" type="BMCodeType">
            <xsd:annotation>
              <xsd:documentation>Bonus-malus besorolás (Külföldi kárelőzmény esetén a befogadó Biztosító által, a kárelőzmény igazolás alapján megállapított bonus-malus besorolás értéke) </xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="usedPolicy" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Felhasznált kártörténet kötvénye</xsd:documentation>
            </xsd:annotation>
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="policyInsCo" type="companyCodeType">
                  <xsd:annotation>
                    <xsd:documentation>Biztosító</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
                <xsd:element name="policyNo">
                  <xsd:annotation>
                    <xsd:documentation>Kötvény száma</xsd:documentation>
                  </xsd:annotation>
                  <xsd:simpleType>
                    <xsd:restriction base="policyNoType">
                      <xsd:pattern value=".*[A-Za-z0-9].*"/>
                    </xsd:restriction>
                  </xsd:simpleType>
                </xsd:element>
                <xsd:element name="policyInternalUid" type="policyInternalUidType" minOccurs="0">
                  <xsd:annotation>
                    <xsd:documentation>Kötvény Kártörténet Nyilvántartásbeli egyedi azonosítója</xsd:documentation>
                  </xsd:annotation>
                </xsd:element>
