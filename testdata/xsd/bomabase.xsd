  <xsd:complexType name="envelopeType">
    <xsd:annotation>
      <xsd:documentation>Boriték fejléc</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="msgTypeName" type="msgType">
        <xsd:annotation>
          <xsd:documentation>Üzenet típusa</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="senderInsCo" type="companyCodeType">
        <xsd:annotation>
          <xsd:documentation>A küldő biztosító - vagy Kártörténeti központ</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="targetInsCo" type="companyCodeType">
        <xsd:annotation>
          <xsd:documentation>A címzett biztosító</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="messageId" type="msgIdType">
        <xsd:annotation>
          <xsd:documentation>Üzenet egyedi azonosító</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="referenceId" type="msgIdType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Hivatkozott üzenet azonosítója</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="highPriorityRequest" type="xsd:boolean" default="false" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Real-time kérés ? (Default: batch)</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="reasonOfRequest" type="reasonOfRequestType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>A kérést illetve üzenetet kiváltó üzleti ok</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="resultCode" type="resultOfRequestType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>A kérés sikeressége, vagy hibaok</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="messageDateTime" type="bomaDateTime">
        <xsd:annotation>
          <xsd:documentation>Az üzenet feladásának ideje</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="requestersId" type="xsd:string" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>A kérés üzenet feladójának saját azonosítója, a válaszban is változatlan tartalommal jelen van. </xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="msgHash" type="xsd:string" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>@Deprecated - nem használt
Az üzenet fő jellemzőiből képzett, azonosításra alkalmas hash</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="encryptedKey" type="xsd:base64Binary">
        <xsd:annotation>
          <xsd:documentation>Az üzenetet titkosító szimmmetrikus kulcs titkosítva</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
