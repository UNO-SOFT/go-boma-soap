                <xsd:documentation>Biztosító</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="policyNo" type="policyNoType">
              <xsd:annotation>
                <xsd:documentation>Kötvény száma</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="policyUsed" type="xsd:boolean">
              <xsd:annotation>
                <xsd:documentation>Kártörténet felhasználva? </xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="vehicleData" type="tempVehicleDataType">
        <xsd:annotation>
          <xsd:documentation>Kötvényhez tartozó gépjármű adatok</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="claimData" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation>Kötvényhez tartozó káresemény adatok</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="dateOfClaimData" type="xsd:date" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation>Kárbejelentés dátuma</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="dateOfAccident" type="xsd:date">
              <xsd:annotation>
                <xsd:documentation>Káresemény dátuma</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="obligationKnownDate" type="xsd:date" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation>Kötelezettség ismertté válásának dátuma</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="payedBackDate" type="xsd:date" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation>Kifizetett kárösszeg visszafizetésének dátuma</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="nextBmRating" type="BMCodeType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>A következo biztosítási idoszakra várható bonus-malus besorolás értéke (a jelenlegi információk alapján kalkulált  nem garantált érték)</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="policyEntryType" type="policyEntryTypeType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>A mező megmutatja, hogy az adott kötvény milyen módon került bejelentésre a Kártörténeti Rendszerbe. Ha nincs megadva, az egyenértékű a "Normál kötvénybejelentés" magadásával.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:simpleType name="policyEntryTypeType">
    <xsd:annotation>
      <xsd:documentation>Kötvény bejelentés típusa</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="NORMAL_ENTRY">
        <xsd:annotation>
          <xsd:documentation>Normál kötvénybejelentés</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="LATE_ENTRY">
        <xsd:annotation>
          <xsd:documentation>Utólagos kötvénybejelentés migrációs céllal, korlátozott konzisztencia ellenőrzés mellett</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="policyInfoKindType">
    <xsd:annotation>
      <xsd:documentation>Kiegészítő adatok típus jelzője</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="POLICY">
        <xsd:annotation>
          <xsd:documentation>Hivatkozott kötvény adata</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="USED_POLICY">
        <xsd:annotation>
          <xsd:documentation>Kárelőzményként hivatkozott kötvény adata</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="POLICY_IS_USED_BY">
        <xsd:annotation>
          <xsd:documentation>Hivatkozott kötvényt kárelőzményként felhasználó kötvény adata</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="USED_POLICY_IS_USED_BY">
        <xsd:annotation>
          <xsd:documentation>Kárelőzményként hivatkozott kötvényt kárelőzményként felhasználó kötvény adata</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="OTHER_POLICY">
        <xsd:annotation>
          <xsd:documentation>A szerződő megadott gépjárművére létező másik kötvény adata</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="USED_POLICY_CONTRACTOR">
        <xsd:annotation>
          <xsd:documentation>Kárelőzményként hivatkozott kötvény szerződőjének adata</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="PAUSE">
        <xsd:annotation>
          <xsd:documentation>Hivatkozott szüneteltetési időszak adata</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="contractorType">
    <xsd:annotation>
      <xsd:documentation>Szerződő típusa</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="PERSON"/>
      <xsd:enumeration value="LEGAL_ENTITY"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="policyStateType">
    <xsd:annotation>
      <xsd:documentation>Kötvény állapota</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="LIVE"/>
      <xsd:enumeration value="CLOSED"/>
      <xsd:enumeration value="PAUSED"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="selectedAdditionalInfoType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="REQUIRED">
        <xsd:annotation>
          <xsd:documentation>Kiegészítő információk átadása szükséges</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="EXTENDED_REQUIRED">
        <xsd:annotation>
          <xsd:documentation>Kiegészítő információk bővített körének átadása szükséges, a biztosító rendelkezik az ügyféltől származó felhatalmazással a bővített kiegészítő információk megismerésére.</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="NOT_REQUIRED">
        <xsd:annotation>
          <xsd:documentation>Kiegészítő információk átadása nem szükséges.</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="bmRatingBasisType">
    <xsd:annotation>
      <xsd:documentation>Besorolás alapja</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="NEW_ENTRY">
        <xsd:annotation>
          <xsd:documentation>Új belépő</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="PARALLEL">
        <xsd:annotation>
          <xsd:documentation>Párhuzamos üzemeltetés</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="EXISTING_CONTRACT">
        <xsd:annotation>
          <xsd:documentation>Meglevő szerződés</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="FOREIGN_DH">
        <xsd:annotation>
          <xsd:documentation>Külföldi kárelőzmény</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="NON_BM_CATEGORY">
        <xsd:annotation>
          <xsd:documentation>Gépjármű kategória nem része a B/M rendszernek</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
</xsd:schema>
