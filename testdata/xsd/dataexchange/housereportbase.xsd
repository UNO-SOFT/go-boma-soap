<?xml version="1.0" encoding="windows-1250" ?>
<xsd:schema 
xmlns:base="http://www.mabisz.hu/dataexchange/base" 
xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.mabisz.hu/dataexchange/household"
            targetNamespace="http://www.mabisz.hu/dataexchange/household" xmlns:basebns="http://www.mabisz.hu/boma" elementFormDefault="qualified">
            <xsd:import schemaLocation="dataexchangebase.xsd" 
               namespace="http://www.mabisz.hu/dataexchange/base"/>
                <xsd:import namespace="http://www.mabisz.hu/boma" schemaLocation="../bomabase.xsd"/>
  <xsd:element name="houseHoldRequest">
    <xsd:annotation>
      <xsd:documentation>Lakásbiztosítási kérés</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="houseHoldClaimsIdentificaton" type="HouseholdClaimsIdentificationType">
          <xsd:annotation>
            <xsd:documentation>Lakásbiztosítási kérés keresési adata</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="claimsDate" type="xsd:date">
          <xsd:annotation>
            <xsd:documentation>Káresemény dátuma</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:sequence>
      <xsd:attribute name="requestId" type="xsd:ID"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="houseHoldResponse">
    <xsd:complexType>
      <xsd:choice>
        <xsd:element name="error" type="base:ErrorType">
          <xsd:annotation>
            <xsd:documentation>Hiba</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="houseHoldResponseData" maxOccurs="unbounded">
          <xsd:annotation>
            <xsd:documentation>Lakásbiztosítás válasz adatai, ha talált</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="householdPolicyNum" type="xsd:string">
                <xsd:annotation>
                  <xsd:documentation>Lakásbiztosítás kötvényszám</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name="baseOfIdentifaction" type="IdentificationType">
                <xsd:annotation>
                  <xsd:documentation>Azonosítás alapja</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name="householdPolicyRiskStartDate" type="xsd:date">
                <xsd:annotation>
                  <xsd:documentation>Lakásbiztosítási kötvény kockázatviselés kezdete</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name="policyRiskTermDate" type="xsd:date" nillable="true">
                <xsd:annotation>
                  <xsd:documentation>Lakásbiztosítási kötvény kockázatviselés vége</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name="householdPolicyContact" type="base:ContactType">
                <xsd:annotation>
                  <xsd:documentation>Lakásbiztosítási kötvény kontakt személy adatai</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name="riskPlace" type="basebns:structuredAddressType">
                <xsd:annotation>
                  <xsd:documentation>Kockázatviselés helye</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name="householdClaims" type="HouseholdClaimsEventType" maxOccurs="unbounded" minOccurs="0"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:choice>
      <xsd:attribute name="requestId"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:complexType name="ParcelNumType">
    <xsd:annotation>
      <xsd:documentation>Helyrajzi szám strukturált adatai</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="city">
        <xsd:annotation>
          <xsd:documentation>Település neve</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="50"/>
							</xsd:restriction>
						</xsd:simpleType>
       </xsd:element>                                         
      <xsd:element name="parcelNum">
        <xsd:annotation>
          <xsd:documentation>Helyrajzi szám</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="50"/>
							</xsd:restriction>
						</xsd:simpleType>
                                                </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="HouseholdLegalEntityType">
  <xsd:complexContent> 
    <xsd:extension base="base:LegalEntityType"> 
    <xsd:sequence>
      
      <xsd:element name="orgType" type="OrganizationType"/>
    </xsd:sequence>
</xsd:extension> 
</xsd:complexContent> 
  </xsd:complexType>
  <xsd:complexType name="BankAccountNumType">
    <xsd:annotation>
      <xsd:documentation>Bankszámla strukturált adatai</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="bankAccountNumPart1" >
        <xsd:annotation>
          <xsd:documentation>Bankszámla első 8 karaktere</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="8"/>
							</xsd:restriction>
						</xsd:simpleType>
       </xsd:element>                                         
      <xsd:element name="bankAccountNumPart2">
        <xsd:annotation>
          <xsd:documentation>Bankszámla második 8 karaktere</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="8"/>
							</xsd:restriction>
						</xsd:simpleType>
       </xsd:element>                                         
      <xsd:element name="bankAccountNumPart3"  maxOccurs="1" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Bankszámla harmadik 8 karaktere</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="8"/>
							</xsd:restriction>
						</xsd:simpleType>
       </xsd:element>                                         
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="PolicyHolderType">
    <xsd:annotation>
      <xsd:documentation>Szerződő strukturált adatai</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:choice>
        <xsd:element name="person" type="base:PersonType">
          <xsd:annotation>
            <xsd:documentation>Természetes személy</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="legalEntity" type="HouseholdLegalEntityType">
          <xsd:annotation>
            <xsd:documentation>Nem-természetes személy</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
      <xsd:element name="bankAccountNum" type="BankAccountNumType">
        <xsd:annotation>
          <xsd:documentation>Bankszámla száma</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="GpsType">
    <xsd:annotation>
      <xsd:documentation>GPS adatok</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="coordLat" type="xsd:double">
        <xsd:annotation>
          <xsd:documentation>GPS szélességi koordináta</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="coordLong" type="xsd:double">
        <xsd:annotation>
          <xsd:documentation>GPS hosszúsági koordináta</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="PlaceType">
    <xsd:annotation>
      <xsd:documentation>Kockázatviselési hely strukturált adatai</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="address" type="basebns:structuredAddressType" minOccurs="0" maxOccurs="1">
        <xsd:annotation>
          <xsd:documentation>Kockázatviselési hely címe</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="parcelNum" type="ParcelNumType" maxOccurs="1" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Kockázatviselési hely helyrajzi száma</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="gps" type="GpsType" maxOccurs="1" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Kockázatviselési hely GPS koordinátái</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="HouseholdClaimsIdentificationType">
    <xsd:sequence>
      <xsd:choice>
        <xsd:element name="riskPlace" type="PlaceType">
          <xsd:annotation>
            <xsd:documentation>Kockázatviselési hely</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="policyHolder" type="PolicyHolderType">
          <xsd:annotation>
            <xsd:documentation>Szerződő</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="HouseholdClaimsEventType">
    <xsd:sequence>
      <xsd:element name="reasonOfClaimsDesc">
        <xsd:annotation>
          <xsd:documentation>Kár, sérülés leírása</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="50"/>
							</xsd:restriction>
						</xsd:simpleType>
      </xsd:element>
      <xsd:element name="propertyGroupDesc">
        <xsd:annotation>
          <xsd:documentation>Vagyon csoport</xsd:documentation>
        </xsd:annotation>
         <xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="50"/>
							</xsd:restriction>
						</xsd:simpleType>
                                     
      </xsd:element>
      <xsd:element name="householdClaimsDate" type="xsd:date">
        <xsd:annotation>
          <xsd:documentation>Lakásbiztosítási káresemény dátuma</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="householdClaimsNum"  minOccurs="1" maxOccurs="1">
        <xsd:annotation>
          <xsd:documentation>Lakásbiztosítási kárszám</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="20"/>
							</xsd:restriction>
						</xsd:simpleType>
      </xsd:element>
      <xsd:element name="householdClaimsContact" type="base:ContactType" minOccurs="1"/>
      <xsd:element name="bankAccountNum" type="BankAccountNumType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Bankszámla száma</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:simpleType name="ErrorCodeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="01">
        <xsd:annotation>
          <xsd:documentation>Unsuccesful policyholder identification</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="02">
        <xsd:annotation>
          <xsd:documentation>Unsuccesful policy identification</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="03">
        <xsd:annotation>
          <xsd:documentation>Unsuccesful claims event identification</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ReasonOfRequestType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="01">
        <xsd:annotation>
          <xsd:documentation>multiple policy</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="02">
        <xsd:annotation>
          <xsd:documentation>claims</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="03">
        <xsd:annotation>
          <xsd:documentation>risk parameter deviation</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ReasonOfClaimsType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="0A">
        <xsd:annotation>
          <xsd:documentation>fire, direct lightning</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="0B">
        <xsd:annotation>
          <xsd:documentation>indirect lightning</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="0C">
        <xsd:annotation>
          <xsd:documentation>Storm, elemantary losses</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
       <xsd:enumeration value="0D">
        <xsd:annotation>
          <xsd:documentation>glass</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
       <xsd:enumeration value="0E">
        <xsd:annotation>
          <xsd:documentation>water pipe damage</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="PopertyGroupType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="P1">
        <xsd:annotation>
          <xsd:documentation>building</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="P2">
        <xsd:annotation>
          <xsd:documentation>general personal estate</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="P3">
        <xsd:annotation>
          <xsd:documentation>art work</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
     
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ReasonOfTerminationType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="DNF">
        <xsd:annotation>
          <xsd:documentation>not payment</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="EM">
        <xsd:annotation>
          <xsd:documentation>end of interest</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="FEB">
        <xsd:annotation>
          <xsd:documentation>termination by insurer</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="FEU">
        <xsd:annotation>
          <xsd:documentation>termination by policyholder</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      
       <xsd:enumeration value="KM">
        <xsd:annotation>
          <xsd:documentation>common agreement</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
       <xsd:enumeration value="O">
        <xsd:annotation>
          <xsd:documentation>other</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="IdentificationType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="riskplace">
        <xsd:annotation>
          <xsd:documentation>Riskplace</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="insured">
        <xsd:annotation>
          <xsd:documentation>Insured</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="policyholder">
        <xsd:annotation>
          <xsd:documentation>Policyholder</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
     
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="OrganizationType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="C">
        <xsd:annotation>
          <xsd:documentation>Company</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="R">
        <xsd:annotation>
          <xsd:documentation>Insured</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="O">
        <xsd:annotation>
          <xsd:documentation>Other</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
     <xsd:enumeration value="T">
        <xsd:annotation>
          <xsd:documentation>Tarsasház</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
</xsd:schema>
