          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="oldValue" type="basebns:BMCodeType" minOccurs="0"/>
              <xsd:element name="newValue" type="basebns:BMCodeType" minOccurs="0"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
