          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="oldValue" type="basebns:bomaDateTime" minOccurs="0"/>
              <xsd:element name="newValue" type="basebns:bomaDateTime"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
