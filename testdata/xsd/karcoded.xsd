              <xsd:element name="oldValue" type="basebns:bmRatingTypeType" minOccurs="0"/>
              <xsd:element name="newValue" type="basebns:bmRatingTypeType"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="nextBmRatingChange">
